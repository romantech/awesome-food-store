{
  "name": "awesome-food-store",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint .",
    "db": "json-server db.json --port 3001",
    "check:fix": "biome check . --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "classnames": "^2.5.1",
    "next": "16.2.12",
    "next-plugin-antd-less": "^1.8.0",
    "next-use-contextual-routing": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@biomejs/biome": "^2.5.9",
    "antd": "4.24.14",
    "autoprefixer": "^10.5.4",
    "babel-plugin-import": "^1.13.8",
    "husky": "^9.1.7",
    "json-server": "1.0.0-beta.15",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  }
}
